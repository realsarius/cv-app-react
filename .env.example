NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

APP_DEV_PORT=3010
APP_PROD_PORT=3011
PGADMIN_PORT=5060

DATABASE_DEV_HOST=localhost
DATABASE_DEV_PORT=5450
DATABASE_DEV_NAME=cv_app_dev
DATABASE_DEV_USER=cv_dev_user
DATABASE_DEV_PASSWORD=dev_password

DATABASE_TEST_HOST=localhost
DATABASE_TEST_PORT=5451
DATABASE_TEST_NAME=cv_app_test
DATABASE_TEST_USER=cv_test_user
DATABASE_TEST_PASSWORD=test_password

DATABASE_PROD_HOST=localhost
DATABASE_PROD_PORT=5452
DATABASE_PROD_NAME=cv_app_prod
DATABASE_PROD_USER=cv_prod_user
DATABASE_PROD_PASSWORD=prod_password

DATABASE_DEV_URL=postgresql://cv_dev_user:dev_password@localhost:5450/cv_app_dev
DATABASE_TEST_URL=postgresql://cv_test_user:test_password@localhost:5451/cv_app_test
DATABASE_PROD_URL=postgresql://cv_prod_user:prod_password@localhost:5452/cv_app_prod
DATABASE_URL=postgresql://cv_dev_user:dev_password@localhost:5450/cv_app_dev

PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin123

INTERNAL_LOG_SECRET=change-me-in-production
CRON_SECRET=change-me-in-production
LOG_IP_HASH_SALT=change-me-in-production
LOGGING_ENABLED=true
LOG_REQUEST_SAMPLE_RATE=0.10
LOG_SLOW_REQUEST_MS=1000
LOG_ALWAYS_PATH_PREFIXES=/dashboard,/resumes,/settings,/login,/register
