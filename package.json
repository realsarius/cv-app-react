{
  "name": "resume-builder",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build --no-lint",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:generate:dev": "DB_ENV=dev drizzle-kit generate",
    "db:generate:test": "DB_ENV=test drizzle-kit generate",
    "db:generate:prod": "DB_ENV=prod drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:dev": "DB_ENV=dev drizzle-kit migrate",
    "db:migrate:test": "DB_ENV=test drizzle-kit migrate",
    "db:migrate:prod": "DB_ENV=prod drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:studio:dev": "DB_ENV=dev drizzle-kit studio",
    "db:studio:test": "DB_ENV=test drizzle-kit studio",
    "db:studio:prod": "DB_ENV=prod drizzle-kit studio",
    "docker:dev:up": "docker compose --profile dev up -d",
    "docker:dev:down": "docker compose --profile dev down",
    "docker:test:up": "docker compose --profile test up -d postgres-test",
    "docker:test:down": "docker compose --profile test down",
    "docker:prod:up": "docker compose --profile prod up -d",
    "docker:prod:down": "docker compose --profile prod down"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.4",
    "drizzle-orm": "^0.44.5",
    "lucide-react": "^0.577.0",
    "next": "^14.2.26",
    "next-intl": "^4.8.3",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.56.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pg": "^8.15.6",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.20",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.6",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.26",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vitest": "^3.2.4"
  }
}
